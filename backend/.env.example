APP_NAME=GitHub Developer Analytics API
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
GITHUB_API_URL=https://api.github.com

# Database Connection URL:
# For local SQLite (zero-configuration development):
DATABASE_URL=sqlite:///./analytics.db
# For PostgreSQL (via Docker Compose or local/cloud Postgres):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/github_analytics

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
CACHE_TTL_SECONDS=3600

# Step 7: GitHub OAuth 2.0 (create at https://github.com/settings/developers)
# The OAuth App's "Authorization callback URL" must match
# GITHUB_OAUTH_REDIRECT_URI exactly (backend callback — code exchange stays
# server-side; the session is stored in an HttpOnly cookie).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
# Minimal scope: public profile only. To opt in to private-repo analytics,
# uncomment the line below (users must explicitly authorize it).
# GITHUB_OAUTH_SCOPE=read:user repo
# Session JWT signing secret (generate: openssl rand -hex 32). Required in prod.
JWT_SECRET=dev-only-change-me
# Token encryption key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# If empty, falls back to a JWT_SECRET-derived key (dev only — set explicitly in prod).
OAUTH_TOKEN_FERNET_KEY=
# Optional server-side token to raise unauthenticated rate limits (60 -> 5,000 req/hr).
# Sent only as a backend Authorization header; never exposed to the frontend.
# Get one at https://github.com/settings/tokens (classic, no scopes needed).
# NEVER commit a real token — keep it in backend/.env (gitignored) only.
# GITHUB_TOKEN=

